<% content_for :title, "Messages" %>
<% partner = @chat.other_participant(current_user) %>

<main class="container py-4">
  <h1 class="h2 mb-4">Messages</h1>
  <div class="row g-4">
    <%= render "chats/inbox" %>
    <section class="col-lg-8" aria-labelledby="conversation-title">
      <div class="card bg-white rounded-4">
        <div class="card-body p-3 p-md-4">
          <h2 id="conversation-title" class="h4 text-break">
            <%= @chat.notes? ? "Me · Personal notes" : (partner.name.presence || partner.email) %>
          </h2>

          <% if @messages.empty? %>
            <p class="text-body-secondary"><%= @chat.notes? ? "No notes yet." : "No messages yet." %></p>
          <% else %>
            <ol class="list-unstyled mb-4" aria-label="Conversation history">
              <% @messages.each do |message| %>
                <% sent = message.sender_id == current_user.id %>
                <li class="rounded-3 p-3 mb-2 <%= sent ? 'bg-primary-subtle ms-md-4' : 'bg-body-tertiary me-md-4' %>">
                  <p class="small text-body-secondary mb-1 text-break">
                    <% if message.task %>
                      <strong>Sagasu Bot</strong> · on behalf of <%= sent ? "you" : (message.sender.name.presence || message.sender.email) %>
                    <% else %>
                      <strong><%= sent ? "You" : (message.sender.name.presence || message.sender.email) %></strong>
                    <% end %>
                    · <%= l(message.created_at, format: :short) %>
                  </p>
                  <div class="text-break"><%= safe_join(message.content.lines.map(&:chomp), tag.br) %></div>
                  <% if message.task&.review_bidder_list? && (approval = message.task.actionable) %>
                    <%= link_to "Open approval", bidder_list_approval_project_path(approval.project_id),
                                class: "btn btn-sm btn-outline-primary mt-2" %>
                  <% end %>
                </li>
              <% end %>
            </ol>
          <% end %>

          <%= form_with url: chat_messages_path(@chat), scope: :message, method: :post, id: "message-composer" do |form| %>
            <%= form.label :content, (@chat.notes? ? "New note" : "New message"), class: "form-label" %>
            <%= form.text_area :content, rows: 3, required: true, maxlength: Message::MAX_LENGTH, class: "form-control mb-2" %>
            <%= form.submit(@chat.notes? ? "Save note" : "Send message", class: "btn btn-primary") %>
          <% end %>
        </div>
      </div>
    </section>
  </div>
</main>
