<% content_for :title, "Messages" %>

<main class="container py-4">
  <h1 class="h2 mb-4">Messages</h1>
  <div class="row g-4">
    <%= render "chats/inbox" %>
    <section class="col-lg-8" aria-labelledby="bot-title">
      <div class="card bg-white rounded-4">
        <div class="card-body p-3 p-md-4">
          <h2 id="bot-title" class="h4">
            <i class="fas fa-robot" aria-hidden="true"></i> Sagasu Bot
          </h2>
          <% if @pending_approvals.empty? && @returned_projects.empty? %>
            <p class="text-body-secondary mb-0">You have no outstanding tasks.</p>
          <% else %>
            <ul class="list-group list-group-flush mt-3">
              <% @pending_approvals.each do |approval| %>
                <% title = approval.bidder_list_version.snapshot.fetch("project").fetch("title") %>
                <li class="list-group-item px-0">
                  <strong>Review bidder list</strong>
                  <%= link_to title, bidder_list_approval_project_path(approval.project_id), class: "d-block text-break" %>
                </li>
              <% end %>
              <% @returned_projects.each do |project| %>
                <li class="list-group-item px-0">
                  <strong>Revise returned RFQ</strong>
                  <%= link_to project.title, bidder_list_approval_project_path(project), class: "d-block text-break" %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>
    </section>
  </div>
</main>
