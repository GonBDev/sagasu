<div class="container py-4">
  <h1>My Projects</h1>

  <% if policy(Project).new? %>
    <%= link_to "New RFQ", new_project_path, class: "btn btn-primary mb-3" %>
  <% end %>

  <%= form_with url: projects_path, method: :get, class: "d-flex gap-2 mb-4" do |f| %>
    <%= f.label :q, "Search projects", class: "visually-hidden" %>
    <%= f.search_field :q, value: @query, placeholder: "Search by title", class: "form-control" %>
    <%= f.submit "Search", class: "btn btn-outline-primary" %>
  <% end %>

  <% if @projects.empty? %>
    <p>No projects found.</p>
  <% else %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
      <% @projects.each do |project| %>
        <div class="col">
          <div class="card h-100">
            <div class="card-body">
              <h2 class="h5"><%= link_to project.title, project_path(project) %></h2>
              <p class="mb-0"><%= project.status.humanize %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
