<% content_for :title, "My Projects | Sagasu" %>
<% statuses = {
  "draft" => ["Draft", "secondary"],
  "pending_approval" => ["Waiting for approval", "warning"],
  "returned" => ["Returned", "danger"],
  "approved" => ["Approved", "success"]
} %>

<main class="container projects-index py-4 py-lg-5">
  <header class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <h1 class="mb-0">My Projects</h1>
    <% if policy(Project).new? %>
      <%= link_to new_project_path, class: "btn btn-primary fw-semibold" do %>
        <i class="fas fa-plus me-1" aria-hidden="true"></i> New project
      <% end %>
    <% end %>
  </header>

  <div class="card bg-white rounded-4 mb-4">
    <div class="card-body p-3">
      <%= form_with url: projects_path, method: :get, class: "projects-index__search", html: { role: "search", aria: { label: "Search projects" } } do |f| %>
        <%= f.hidden_field :status, value: @status if @status %>
        <%= f.label :q, "Search projects by title", class: "visually-hidden" %>
        <%= f.search_field :q, value: @query, placeholder: "Search by title", class: "form-control" %>
        <%= f.submit "Search", class: "btn btn-outline-primary" %>
        <% if @query.present? %>
          <%= link_to "Clear search", projects_path(status: @status), class: "btn btn-link text-nowrap" %>
        <% end %>
      <% end %>

      <nav class="nav nav-pills flex-wrap gap-1 mt-3 projects-index__filters" aria-label="Filter projects by status">
        <% { nil => ["All", nil] }.merge(statuses).each do |status, (label, _color)| %>
          <% count = status ? @status_counts.fetch(status, 0) : @status_counts.values.sum %>
          <%= link_to projects_path(status: status, q: @query.presence), class: class_names("nav-link", active: @status == status),
                      aria: { current: ("page" if @status == status) } do %>
            <%= label %> <span class="badge rounded-pill bg-light text-dark"><%= number_with_delimiter(count) %></span>
          <% end %>
        <% end %>
      </nav>
    </div>
  </div>

  <% if @projects.empty? %>
    <div class="card bg-white rounded-4 p-4">
      <h2 class="h5">No projects found</h2>
      <% if @query.present? || @status %>
        <p class="text-body-secondary mb-3">Try a different search or status.</p>
        <%= link_to "Show all projects", projects_path, class: "align-self-start" %>
      <% end %>
    </div>
  <% else %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
      <% @projects.each do |project| %>
        <% label, color = statuses.fetch(project.status) %>
        <% material_count = @material_counts.fetch(project.id, 0) %>
        <% grouped_count = @grouped_counts.fetch(project.id, 0) %>
        <div class="col">
          <article class="card bg-white rounded-4 shadow-sm h-100 projects-index__card">
            <div class="card-body d-flex flex-column p-3 p-lg-4">
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <p class="small text-body-secondary text-break mb-0"><%= project.erp_rfq.presence || "No ERP reference" %></p>
                <span class="badge rounded-pill bg-<%= color %>-subtle text-<%= color %>-emphasis"><%= label %></span>
              </div>
              <h2 class="h5 fw-semibold text-break mb-2">
                <%= link_to project.title, project_path(project), class: "projects-index__title" %>
              </h2>
              <% if project.client_name.present? || project.client_area.present? %>
                <p class="small text-body-secondary text-break mb-0"><%= [project.client_name.presence, project.client_area.presence].compact.join(" · ") %></p>
              <% end %>

              <div class="mt-auto pt-3">
                <dl class="projects-index__metrics small mb-3">
                  <div><dt>Materials</dt><dd><%= number_with_delimiter(material_count) %></dd></div>
                  <div><dt>Groups</dt><dd><%= number_with_delimiter(@group_counts.fetch(project.id, 0)) %></dd></div>
                  <div><dt>Suppliers selected</dt><dd><%= number_with_delimiter(@selection_counts.fetch(project.id, 0)) %></dd></div>
                </dl>
                <% if material_count.positive? %>
                  <p class="small text-body-secondary mb-1">Materials grouped: <%= grouped_count %> of <%= material_count %></p>
                  <progress class="projects-index__progress mb-2" aria-label="Materials grouped" value="<%= grouped_count %>" max="<%= material_count %>"></progress>
                <% end %>
                <p class="small text-body-secondary mb-0">Updated <%= time_ago_in_words(project.updated_at) %> ago</p>
              </div>
            </div>
          </article>
        </div>
      <% end %>
    </div>
  <% end %>
</main>
