<section class="card bg-white rounded-4 mt-3" aria-labelledby="supplier-invitations-title">
  <div class="card-body p-3 p-md-4">
    <h2 id="supplier-invitations-title" class="h4">Invite suppliers</h2>
    <p class="text-body-secondary">
      Review drafts for approved version <%= version.version_number %>, then send them from your email app or Gmail.
    </p>

    <% if template_error %>
      <p class="alert alert-warning mb-0" role="alert"><%= template_error %></p>
    <% elsif invitations.empty? %>
      <p class="mb-0">The approved version has no selected suppliers.</p>
    <% else %>
      <% invitations.each do |invitation| %>
        <details class="border rounded-3 p-3 mb-2">
          <summary class="fw-semibold text-break"><%= invitation.supplier_name %></summary>
          <% if invitation.unavailable_reason %>
            <p class="text-body-secondary mt-2 mb-0"><%= invitation.unavailable_reason %></p>
          <% else %>
            <dl class="mt-3 mb-2 text-break">
              <dt>To</dt>
              <dd><%= invitation.email %></dd>
              <dt>Subject</dt>
              <dd><%= invitation.subject %></dd>
            </dl>
            <label class="form-label fw-semibold d-block">Message preview
              <textarea class="form-control mt-1" rows="8" readonly><%= invitation.body %></textarea>
            </label>
            <div class="d-flex flex-wrap gap-2 mt-3">
              <%= mail_to invitation.email, "Open in email app", subject: invitation.subject, body: invitation.body,
                          class: "btn btn-primary", data: { turbo: false } %>
              <%= link_to "Open in Gmail", invitation.gmail_url, class: "btn btn-outline-primary",
                          target: "_blank", rel: "noopener noreferrer" %>
            </div>
          <% end %>
        </details>
      <% end %>
    <% end %>
  </div>
</section>
