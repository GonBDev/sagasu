<% editing = @project.persisted? %>
<% currencies = Project::BUDGET_CURRENCIES %>
<% currencies |= [@project.budget_currency_in_database].compact_blank if editing %>

<main class="container py-4 py-md-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">
      <div class="card bg-white rounded-4 shadow-sm">
        <%= tag.div class: "card-body p-3 p-sm-4", data: { controller: ("smart-fill" unless editing) } do %>
          <header class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <h1 class="h3 mb-0"><%= editing ? "Edit project information" : "New supply project" %></h1>
            <% unless editing %>
              <button type="button" class="btn btn-outline-ai" data-bs-toggle="collapse"
                      data-bs-target="#smart-fill-panel" aria-expanded="false" aria-controls="smart-fill-panel">
                Smart Fill
              </button>
            <% end %>
          </header>
          <% unless editing %>
            <div class="collapse" id="smart-fill-panel">
              <%= form_with url: smart_fill_projects_path(format: :json), method: :post, local: true, class: "border-bottom pb-3 mb-4",
                            data: { turbo: false, action: "submit->smart-fill#fill" } do |form| %>
                <%= form.label :smart_fill_text, "Paste an email or request", class: "form-label" %>
                <%= form.text_area :smart_fill_text, rows: 7, required: true, class: "form-control",
                                   maxlength: ProjectSmartFill::MAX_INPUT_LENGTH, aria: { describedby: "smart-fill-help" } %>
                <p id="smart-fill-help" class="small text-body-secondary mt-2 mb-3">The pasted text is sent to the AI provider. Review the filled fields before saving.</p>
                <%= form.button class: "btn btn-ai", data: { smart_fill_target: "submit" } do %>
                  Fill with AI <i class="fa-solid fa-wand-magic-sparkles ms-1" aria-hidden="true"></i>
                <% end %>
                <p class="small mt-2 mb-0" role="status" data-smart-fill-target="status"></p>
              <% end %>
            </div>
          <% end %>

          <%= simple_form_for @project, html: { data: { smart_fill_target: ("projectForm" unless editing) } } do |f| %>
            <%= f.input :title, as: :string %>
            <%= f.input :erp_rfq, label: "ERP reference", as: :string %>
            <%= f.input :scope %>

            <div class="row gx-3">
              <div class="col-sm-6"><%= f.input :client_name, as: :string %></div>
              <div class="col-sm-6"><%= f.input :client_area, as: :string %></div>
            </div>
            <div class="row gx-3">
              <div class="col-sm-6">
                <%= f.input :budget_currency, as: :select, collection: currencies, include_blank: "Choose a currency" %>
              </div>
              <div class="col-sm-6"><%= f.input :budget_amount %></div>
            </div>

            <%= f.input :buyer_comment %>

            <div class="d-flex flex-wrap gap-2 border-top pt-3 mt-4">
              <%= f.button :submit, editing ? "Save changes" : "Save draft", class: "btn btn-primary" %>
              <% if editing %>
                <%= link_to "Cancel", project_path(@project), class: "btn btn-outline-secondary" %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</main>
