<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
  <div>
    <h2 id="material-groups-title" class="h4 mb-1">Material groups</h2>
    <p class="small text-body-secondary mb-0">
      <%= pluralize(groups.size, "group") %> · <%= pluralize(@items.size, "material") %> · <%= ungrouped_materials.size %> ungrouped
    </p>
  </div>
  <% if can_manage_groups && ungrouped_materials.any? %>
    <%= button_to "Suggest groups", propose_project_item_groups_path(@project), method: :post, class: "btn btn-outline-primary mb-3" %>
  <% end %>
</div>

<% if can_manage_groups && @proposed_groups.present? %>
  <%= render "item_group_proposal", project: @project, groups: @proposed_groups, materials_by_id: @items.index_by(&:id), proposal_id: @proposal_id %>
<% end %>

<% if can_manage_groups %>
  <details class="card bg-white rounded-4 p-3 mb-3">
    <summary class="fw-semibold text-primary">Create a group manually</summary>
    <%= simple_form_for :item_group, url: project_item_groups_path(@project), method: :post, html: { class: "mt-3" } do |form| %>
      <%= form.input :title, label: "Group name", required: true %>
      <%= form.button :submit, "Create group", class: "btn btn-primary" %>
    <% end %>
  </details>
<% end %>

<% groups.each do |group| %>
  <section class="card bg-white rounded-4 mb-3 overflow-hidden">
    <div class="card-header bg-body px-3 py-3">
      <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2">
        <h3 class="h5 mb-0 text-break"><i class="fas fa-layer-group me-1" aria-hidden="true"></i><%= group.title %></h3>
        <span class="small text-body-secondary"><%= pluralize(materials_by_group.fetch(group.id, []).size, "material") %></span>
      </div>
    </div>

    <% if can_manage_groups %>
      <details class="card-footer bg-white px-3 py-3">
        <summary class="fw-semibold text-primary">Manage group</summary>
        <%= simple_form_for group, url: project_item_group_path(@project, group), method: :patch, html: { class: "mt-3" } do |form| %>
          <%= form.input :title, label: "Group name", input_html: { id: dom_id(group, :title) } %>
          <%= form.button :submit, "Rename group", class: "btn btn-outline-primary" %>
        <% end %>
        <%= button_to "Delete group", project_item_group_path(@project, group), method: :delete, class: "btn btn-outline-danger mt-2", form: { data: { turbo_confirm: "Delete this group? Its materials will become ungrouped." } } %>
      </details>
    <% end %>
  </section>
<% end %>
<%= render "materials", can_edit_materials: can_edit_materials, assign_groups: true,
                        material_group_options: material_group_options %>
