<% content_for :title, @project.title %>
<% can_open_workspace = policy(@project).show? %>
<% can_manage_groups = policy(@project).manage_item_groups? %>
<% can_edit_materials = policy(@project).edit_material? %>
<% can_add_material = policy(@project).add_material? %>
<% groups = @project.item_groups.order(:title, :id).to_a %>
<% materials_by_group = @items.group_by(&:item_group_id) %>
<% ungrouped_materials = materials_by_group.fetch(nil, []) %>
<% material_group_options = groups.map { |group| [group.title, group.id] } %>
<% status_color = { "approved" => "success", "pending_approval" => "warning", "returned" => "danger" }.fetch(@project.status, "primary") %>

<main class="container py-4 py-lg-5">
  <nav aria-label="Breadcrumb" class="mb-3">
    <%= link_to "← All projects", projects_path, class: "link-primary text-decoration-underline" %>
  </nav>

  <header class="card bg-white rounded-4 mb-4">
    <div class="card-body p-3 p-md-4">
      <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
        <div class="text-break">
          <p class="small text-body-secondary mb-1"><%= @project.erp_rfq.presence || "RFQ project" %></p>
          <h1 class="h2 mb-0"><%= @project.title %></h1>
        </div>
        <span class="badge rounded-pill border bg-<%= status_color %>-subtle text-<%= status_color %>-emphasis">
          Status: <%= @project.status.humanize %>
        </span>
      </div>

      <% if @project.scope.present? %>
        <h2 class="h6 mb-1">Scope</h2>
        <p class="text-break mb-3"><%= @project.scope %></p>
      <% end %>

      <dl class="row g-3 mb-0 small">
        <div class="col-sm-4 text-break">
          <dt class="text-body-secondary">Client</dt>
          <dd class="mb-0"><%= @project.client_name.presence || "—" %></dd>
        </div>
        <div class="col-sm-4 text-break">
          <dt class="text-body-secondary">Client area</dt>
          <dd class="mb-0"><%= @project.client_area.presence || "—" %></dd>
        </div>
        <div class="col-sm-4 text-break">
          <dt class="text-body-secondary">Budget</dt>
          <dd class="mb-0">
            <% if @project.budget_amount.present? %>
              <%= number_with_delimiter(@project.budget_amount.to_s("F")) %> <%= @project.budget_currency %>
            <% else %>
              —
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </header>

  <% active_step = request.path_parameters.fetch(:workspace_step, "materials") %>
  <nav aria-label="Bidder list steps" class="nav nav-pills flex-wrap gap-2 mb-4">
    <% if can_open_workspace %>
      <%= link_to "Materials", bidder_list_materials_project_path(@project),
                  class: class_names("nav-link", active: active_step == "materials"),
                  aria: { current: ("step" if active_step == "materials") } %>
      <%= link_to "Groups", bidder_list_groups_project_path(@project),
                  class: class_names("nav-link", active: active_step == "groups"),
                  aria: { current: ("step" if active_step == "groups") } %>
      <%= link_to "Suppliers", bidder_list_suppliers_project_path(@project),
                  class: class_names("nav-link", active: active_step == "suppliers"),
                  aria: { current: ("step" if active_step == "suppliers") } %>
    <% end %>
    <%= link_to "Approval", bidder_list_approval_project_path(@project),
                class: class_names("nav-link", active: active_step == "approval"),
                aria: { current: ("step" if active_step == "approval") } %>
  </nav>

  <div class="row g-4 align-items-start">
    <% if active_step == "approval" %>
      <div class="col-lg-8">
        <%= render "projects/approval", project: @project, review_state: @review_state,
                                        can_submit: policy(@project).submit_approval?, can_open_suppliers: can_open_workspace,
                                        submission_version: @submission_version, submission_outdated: @submission_outdated,
                                        eligible_approvers: @eligible_approvers %>
      </div>
    <% elsif active_step == "groups" %>
      <section class="col-lg-8" aria-labelledby="material-groups-title">
        <%= render "groups", groups: groups, materials_by_group: materials_by_group,
                            ungrouped_materials: ungrouped_materials, material_group_options: material_group_options,
                            can_manage_groups: can_manage_groups, can_edit_materials: can_edit_materials %>
      </section>

      <aside class="col-lg-4" aria-labelledby="group-summary-title">
        <div class="card bg-white rounded-4">
          <div class="card-body p-3 p-md-4">
            <h2 id="group-summary-title" class="h5">Group summary</h2>
            <dl class="mb-0">
              <% groups.each do |group| %>
                <div class="d-flex flex-wrap justify-content-between gap-2 border-bottom py-2">
                  <dt class="text-break"><%= group.title %></dt>
                  <dd class="mb-0"><%= pluralize(materials_by_group.fetch(group.id, []).size, "material") %></dd>
                </div>
              <% end %>
              <div class="d-flex flex-wrap justify-content-between gap-2 pt-2">
                <dt>Ungrouped</dt>
                <dd class="mb-0"><%= pluralize(ungrouped_materials.size, "material") %></dd>
              </div>
            </dl>
          </div>
        </div>
      </aside>
    <% elsif active_step == "suppliers" %>
      <div class="col-lg-8">
        <%= render "projects/suppliers", project: @project, groups: groups, materials_by_group: materials_by_group,
                                        suggestions_by_group: @supplier_suggestions_by_group, can_manage_groups: can_manage_groups,
                                        selected_by_group: @selected_suppliers_by_group, search_group: @supplier_search_group,
                                        search_query: @supplier_query, search_results: @supplier_search_results %>
      </div>
      <aside class="col-lg-4" aria-labelledby="draft-bidder-list-title">
        <div class="card bg-white rounded-4">
          <div class="card-body p-3 p-md-4">
            <h2 id="draft-bidder-list-title" class="h5">Draft bidder list</h2>
            <% if @latest_bidder_list_version %>
              <div class="mb-3 small" role="status">
                <span class="fw-semibold">Saved version <%= @latest_bidder_list_version.version_number %></span>
                <% if @bidder_list_unsaved %>
                  <span class="badge bg-warning-subtle text-warning-emphasis">Unsaved changes</span>
                <% end %>
                <p class="text-body-secondary mb-1"><%= l(@latest_bidder_list_version.created_at, format: :short) %></p>
                <%= link_to "View saved version", project_bidder_list_version_path(@project, @latest_bidder_list_version) %>
              </div>
            <% end %>
            <% if @selected_suppliers_by_group.empty? %>
              <p class="text-body-secondary mb-0">No suppliers selected.</p>
            <% else %>
              <% groups.each do |group| %>
                <% selections = @selected_suppliers_by_group.fetch(group.id, []) %>
                <% next if selections.empty? %>
                <h3 class="h6 mt-3 mb-1 text-break"><%= group.title %></h3>
                <ul class="list-group list-group-flush">
                  <% selections.each do |entry| %>
                    <li class="list-group-item px-0 d-flex flex-wrap align-items-center justify-content-between gap-2">
                      <%= link_to entry.supplier.name, supplier_path(entry.supplier), class: "text-break" %>
                      <% unless entry.supplier.active? %>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis">Inactive</span>
                      <% end %>
                      <% if can_manage_groups %>
                        <%= button_to "Remove", shortlist_supplier_project_item_group_path(@project, group),
                                      method: :patch, params: { supplier_id: entry.supplier_id, selected: "false" },
                                      class: "btn btn-sm btn-outline-secondary", aria: { label: "Remove #{entry.supplier.name} from #{group.title}" } %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            <% end %>
            <% if can_manage_groups && @selected_suppliers_by_group.any? %>
              <%= button_to "Save bidder list", project_bidder_list_versions_path(@project), method: :post,
                            class: "btn btn-primary mt-3", data: { turbo_submits_with: "Saving…" } %>
            <% end %>
          </div>
        </div>
      </aside>
    <% else %>
      <section class="<%= can_add_material ? 'col-lg-8' : 'col-12' %>" aria-labelledby="materials-title">
        <%= render "projects/materials", can_edit_materials: can_edit_materials, assign_groups: false,
                                material_group_options: material_group_options %>
      </section>
      <% if can_add_material %>
        <aside class="col-lg-4" aria-labelledby="add-material-title">
          <div class="card bg-white rounded-4">
            <div class="card-body p-3 p-md-4">
              <h2 id="add-material-title" class="h4 mb-3">Add material</h2>
              <%= render "items/form", project: @project, item: @item, submit_label: "Add material" %>
            </div>
          </div>
          <div class="mt-3">
            <%= render "projects/material_import", project: @project, pasted_text: @material_import_text,
                                                  result: @material_import, token: @material_import_token %>
          </div>
        </aside>
      <% end %>
    <% end %>
  </div>
</main>
