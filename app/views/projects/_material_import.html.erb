<%= tag.details class: "card bg-white rounded-4 project-form-disclosure", open: result.present? do %>
  <summary class="p-3 p-md-4">
    <h2 id="material-import-title" class="h4 mb-0 d-flex align-items-center justify-content-between gap-2">
      Paste materials
      <span aria-hidden="true">
        <i class="fas fa-plus small project-form-disclosure__plus"></i>
        <i class="fas fa-chevron-down small project-form-disclosure__chevron"></i>
      </span>
    </h2>
  </summary>
  <div class="card-body px-3 px-md-4 pb-3 pb-md-4 pt-0">

    <%= form_with url: preview_import_project_items_path(project), method: :post, data: { turbo: false } do |form| %>
      <%= form.label :materials_text, "Material list", class: "form-label fw-semibold" %>
      <p id="material-import-format" class="small text-body-secondary mb-2">
        One material per line. Use <strong>description; quantity; unit</strong>.
      </p>
      <%= form.text_area :materials_text, value: pasted_text, rows: 6, required: true, class: "form-control font-monospace",
                         placeholder: "Facing bricks, red; 50000; pcs\nMortar mix M4; 300; bag",
                         aria: { describedby: "material-import-format" } %>
      <%= form.submit "Review import", class: "btn btn-outline-primary mt-3" %>
    <% end %>

    <% if result&.errors&.any? %>
      <div class="alert alert-danger mt-3 mb-0" role="alert">
        <h3 class="h6">Fix these lines before importing</h3>
        <ul class="mb-0">
          <% result.errors.each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% elsif result&.valid? && token.present? %>
      <div class="border-top mt-4 pt-3">
        <h3 class="h6">Review <%= pluralize(result.rows.size, "material") %></h3>
        <ul class="list-group list-group-flush mb-3">
          <% result.rows.each do |row| %>
            <li class="list-group-item px-0 text-break">
              <strong><%= row.fetch(:description) %></strong>
              <span class="d-block small text-body-secondary">
                <%= number_with_precision(row.fetch(:quantity), strip_insignificant_zeros: true, precision: nil) %>
                <%= row.fetch(:unit_of_measure) %>
              </span>
            </li>
          <% end %>
        </ul>
        <%= button_to "Import materials", import_project_items_path(project), method: :post,
                      params: { material_import_token: token }, form: { data: { turbo: false } },
                      class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
<% end %>
