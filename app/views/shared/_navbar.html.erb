<nav class="navbar navbar-expand-lg navbar-lewagon" aria-label="Main navigation">
  <div class="sagasu-nav-inner">
    <%= link_to root_path, class: "navbar-brand", aria: { label: "Sagasu home" } do %>
      <%= image_tag "sagasu-logo-mark.svg", alt: "", width: 34, height: 34 %>
      <span>Sagasu</span>
    <% end %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav">
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to "Dashboard", dashboard_path, class: "nav-link", aria: { current: ("page" if current_page?(dashboard_path)) } %>
          </li>
          <li class="nav-item"><%= link_to "Quick Start", dashboard_path(anchor: "quick-start"), class: "nav-link" %></li>
          <li class="nav-item">
            <%= link_to "My Projects", projects_path, class: "nav-link", aria: { current: ("page" if current_page?(projects_path)) } %>
          </li>
          <li class="nav-item">
            <%= link_to "Suppliers", suppliers_path, class: "nav-link", aria: { current: ("page" if current_page?(suppliers_path)) } %>
          </li>
          <% if policy(Approval).index? %>
            <li class="nav-item">
              <%= link_to "Approvals", approvals_path, class: "nav-link", aria: { current: ("page" if current_page?(approvals_path)) } %>
            </li>
          <% end %>
          <li class="nav-item">
            <%= link_to "Messages", messages_path, class: "nav-link",
                        aria: { current: ("page" if controller_name == "chats") } %>
          </li>
        <% else %>
          <li class="nav-item"><%= link_to "Quick Start", root_path(anchor: "quick-start"), class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "How it works", root_path(anchor: "how-it-works"), class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Trust & evidence", root_path(anchor: "trust-and-evidence"), class: "nav-link" %></li>
        <% end %>
      </ul>

      <div class="sagasu-nav-actions">
        <% if user_signed_in? %>
          <% if policy(Project).new? %>
            <%= link_to new_project_path, class: "btn btn-primary gap-2 fw-semibold" do %>
              <i class="fas fa-plus" aria-hidden="true"></i> New project
            <% end %>
          <% end %>
          <% account_name = current_user.name.to_s.squish.presence %>
          <% name_parts = account_name.to_s.split %>
          <% initials = [name_parts.first, (name_parts.last if name_parts.size > 1)].compact.map(&:first).join %>
          <div class="dropdown sagasu-nav-account-group">
            <button type="button" class="btn sagasu-nav-account" id="navbarDropdown"
                    data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
              <span class="sagasu-nav-avatar" aria-hidden="true"><%= (initials.presence || current_user.email.first).to_s.upcase %></span>
              <i class="fas fa-chevron-down small" aria-hidden="true"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-end sagasu-nav-menu" aria-labelledby="navbarDropdown">
              <div class="sagasu-nav-profile">
                <% if account_name %>
                  <p class="sagasu-nav-name"><%= account_name %></p>
                <% end %>
                <p class="sagasu-nav-email"><%= current_user.email %></p>
                <div class="d-flex flex-wrap gap-1">
                  <% current_user.user_roles.order(:role).each do |user_role| %>
                    <span class="sagasu-nav-role"><%= user_role.role %></span>
                  <% end %>
                </div>
              </div>
              <hr class="dropdown-divider">
              <%= link_to edit_user_registration_path, class: "dropdown-item" do %>
                <i class="fas fa-user-cog fa-fw" aria-hidden="true"></i> Account
              <% end %>
              <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item" do %>
                <i class="fas fa-sign-out-alt fa-fw" aria-hidden="true"></i> Log out
              <% end %>
            </div>
          </div>
        <% else %>
          <%= link_to "Log in", new_user_session_path, class: "btn btn-outline-primary" %>
          <%= link_to "Get started", new_user_registration_path, class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
