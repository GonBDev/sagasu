<% content_for :title, "Edit material | Sagasu" %>

<main class="container py-4 py-md-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">
      <div class="card bg-white rounded-4 shadow-sm">
        <div class="card-body p-3 p-sm-4">
          <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-4">
            <h1 class="h3 mb-0">Edit material</h1>
            <%= link_to project_path(@project), class: "small link-primary" do %>
              <i class="fas fa-arrow-left me-1" aria-hidden="true"></i> Back to project
            <% end %>
          </div>

          <%= render "items/form", project: @project, item: @item, submit_label: "Save changes" %>
        </div>
      </div>
    </div>
  </div>
</main>
