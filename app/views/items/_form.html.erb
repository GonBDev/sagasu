  <%= simple_form_for [project, item] do |f| %>
    <%= f.input :erp_material, label: "ERP material code", as: :string %>
    <%= f.input :description %>
    <%= f.input :quantity, input_html: { step: "any" } %>
    <%= f.input :unit_of_measure, as: :string %>
    <%= f.button :submit, submit_label, class: "btn btn-primary" %>
  <% end %>
