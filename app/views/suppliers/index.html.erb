<% content_for :title, "Suppliers | Sagasu" %>

<main class="container supplier-directory py-4 py-lg-5">
  <h1 class="mb-4">Suppliers</h1>

  <%= turbo_frame_tag "supplier-directory-results", class: "d-block", data: { turbo_action: "replace" } do %>
    <% suppliers = @suppliers.to_a %>
    <section class="card bg-white rounded-4 mb-3" aria-label="Search supplier directory">
      <div class="card-body p-3">
        <%= render "suppliers/searchbar", search_path: suppliers_path, query: @query, group_id: nil,
                   input_id: "supplier-directory-query", clear_path: (suppliers_path if @query.present?) %>
      </div>
    </section>

    <% if suppliers.empty? %>
      <div class="card bg-white rounded-4 p-4">
        <h2 class="h5 mb-0"><%= @query.present? ? "No active suppliers match your search." : "No suppliers have been added yet." %></h2>
        <% if @query.present? %>
          <p class="text-body-secondary mt-2 mb-0">Try another name, category, or tag.</p>
        <% end %>
      </div>
    <% else %>
      <p class="small text-body-secondary mb-3"><%= pluralize(suppliers.size, "supplier") %><%= " found" if @query.present? %></p>
      <ul class="list-unstyled row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-0" role="list">
        <% suppliers.each do |supplier| %>
          <% location = [supplier.city, supplier.state_name, supplier.country_code].filter_map(&:presence).uniq.join(", ") %>
          <% tags = supplier.tags.select(&:present?).uniq %>
          <li class="col">
            <article class="card bg-white rounded-4 shadow-sm h-100 supplier-directory__card">
              <div class="card-body d-flex flex-column p-3 p-lg-4">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-2">
                  <h2 class="h5 fw-semibold text-break mb-0">
                    <%= link_to supplier.name, supplier_path(supplier), class: "supplier-directory__title", data: { turbo_frame: "_top" } %>
                  </h2>
                  <% unless supplier.active.nil? %>
                    <span class="badge rounded-pill <%= supplier.active? ? 'bg-success-subtle text-success-emphasis' : 'bg-secondary-subtle text-secondary-emphasis' %>">
                      <%= supplier.active? ? "Active" : "Inactive" %>
                    </span>
                  <% end %>
                </div>

                <% if supplier.category.present? %>
                  <p class="small fw-semibold text-break mb-2"><%= supplier.category %></p>
                <% end %>
                <% if location.present? %>
                  <p class="small text-body-secondary text-break mb-2">
                    <i class="fas fa-location-dot me-1" aria-hidden="true"></i><%= location %>
                  </p>
                <% end %>
                <div class="d-flex flex-wrap gap-2 small text-body-secondary text-break">
                  <% if supplier.size.present? %><span>Size: <%= supplier.size.humanize %></span><% end %>
                  <% if supplier.erp_vendor_id.present? %><span>ERP: <%= supplier.erp_vendor_id %></span><% end %>
                </div>

                <% if tags.any? %>
                  <ul class="supplier-directory__tags list-unstyled d-flex flex-wrap gap-1 mt-auto mb-0 pt-3" role="list" aria-label="Supplier tags">
                    <% tags.first(3).each do |tag| %>
                      <li class="rounded-pill bg-primary-subtle text-primary-emphasis px-2 py-1 text-break"><%= tag %></li>
                    <% end %>
                    <% if tags.size > 3 %>
                      <li class="px-1 py-1 text-body-secondary">+<%= tags.size - 3 %> more</li>
                    <% end %>
                  </ul>
                <% end %>
              </div>
            </article>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</main>
