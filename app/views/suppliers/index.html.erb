<div class="container py-4">
  <h1>Suppliers</h1>

  <% if @suppliers.empty? %>
    <p>No suppliers have been added yet.</p>
  <% else %>
    <ul class="list-group">
      <% @suppliers.each do |supplier| %>
        <li class="list-group-item"><%= supplier.name %></li>
      <% end %>
    </ul>
  <% end %>
</div>
