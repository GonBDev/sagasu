<%= form_with url: search_path, method: :get, class: "d-flex flex-wrap align-items-end gap-2" do |form| %>
  <% if group_id %>
    <%= form.hidden_field :supplier_group_id, value: group_id, id: nil %>
  <% end %>
  <div>
    <%= form.label :q, "Search suppliers", for: input_id, class: "form-label mb-1" %>
    <%= form.search_field :q, id: input_id, value: query, class: "form-control", placeholder: "Name, category, or tag" %>
  </div>
  <%= form.submit "Search", class: "btn btn-outline-primary" %>
<% end %>
