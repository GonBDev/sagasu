<% content_for :title, "Approvals" %>

<main class="container py-4 py-lg-5">
  <h1 class="h2">Approvals</h1>
  <p class="text-body-secondary"><%= @show_approvers ? "Pending bidder lists across Sagasu." : "Bidder lists assigned to you for review." %></p>

  <div class="card bg-white rounded-4">
    <% if @approvals.empty? %>
      <p class="card-body text-body-secondary mb-0">No bidder lists are waiting for review.</p>
    <% else %>
      <ul class="list-group list-group-flush rounded-4">
        <% @approvals.each do |approval| %>
          <% version = approval.bidder_list_version %>
          <% buyer = approval.project.user %>
          <li class="list-group-item p-3 p-md-4">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
              <div class="text-break">
                <h2 class="h5 mb-1"><%= version.snapshot.fetch("project").fetch("title") %></h2>
                <p class="small text-body-secondary mb-0">
                  Buyer: <%= buyer.name.presence || buyer.email %> · Version <%= version.version_number %> ·
                  Submitted <%= l(approval.created_at, format: :short) %>
                </p>
                <% if @show_approvers %>
                  <p class="small text-body-secondary mb-0">Approver: <%= approval.approver.name.presence || approval.approver.email %></p>
                <% end %>
              </div>
              <%= link_to "Open approval", bidder_list_approval_project_path(approval.project_id), class: "btn btn-outline-primary" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</main>
